root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,xml,html,js,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Match the Google formatter for handwritten tests.
[source/BugzillaLyoArchives/src/test/java/**/*.java]
indent_size = 2

# Preserve Lyo Designer/Acceleo output conventions.
[*.{java,jsp,xml}]
trim_trailing_whitespace = false
